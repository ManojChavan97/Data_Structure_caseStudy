

text = ""
undo_stack = []
redo_stack = []

while True:
    print("\n--- Text Editor ---")
    print("1. Add Text")
    print("2. Undo")
    print("3. Redo")
    print("4. Display Text")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        undo_stack.append(text)
        text = input("Enter text to add: ")
        redo_stack.clear()
        print("Text added successfully!")

    elif choice == "2":
        if len(undo_stack) > 0:
            redo_stack.append(text)
            text = undo_stack.pop()
            print("Undo successful!")
        else:
            print("Nothing to undo!")

    elif choice == "3":
        if len(redo_stack) > 0:
            undo_stack.append(text)
            text = redo_stack.pop()
            print("Redo successful!")
        else:
            print("Nothing to redo!")

    elif choice == "4":
        print("Current Text:", text)

    elif choice == "5":
        print("Exiting Text Editor...")
        break

    else:
        print("Invalid choice! Try again.")
